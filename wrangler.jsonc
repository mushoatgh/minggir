{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "minggir",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "minggir-db","database_id": "8fab7550-032c-4b02-b2c4-5a6757d3c482",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "minggir-media","preview_bucket_name": "minggir-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
